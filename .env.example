# Ambiente: o build de produção (npm start / Docker) força NODE_ENV=production automaticamente.
# NODE_ENV=development
PORT=3000
# URL pública usada em links e QR Codes (sem barra final). Deixe vazio para usar o endereço
# acessado (útil na rede local: http://IP-DO-COMPUTADOR:3000 para os celulares do público).
PUBLIC_URL=

# Banco de dados
#  - pglite:./.data/db      -> PostgreSQL embutido (WASM) para desenvolvimento local
#  - pglite:memory          -> banco em memória (testes)
#  - postgres://usuario:senha@host:5432/banco -> PostgreSQL de produção
DATABASE_URL=pglite:./.data/db
#  - Supabase: painel > Connect > "Session pooler" (porta 5432). Caracteres especiais da senha (@ # / :) precisam
#    ser codificados (@ -> %40). As tabelas são criadas na inicialização e o RLS é ligado automaticamente.
# SSL: disable | require | verify (padrão: require para hosts remotos, desligado para localhost)
# DB_SSL=
# Conexões no pool (no Supabase, fique abaixo do limite do plano; 10 é seguro)
# DB_POOL_MAX=10

# Redis (opcional). Necessário apenas para múltiplas instâncias (adapter do Socket.IO).
REDIS_URL=

# Segredo para assinar tokens internos. Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=troque-este-segredo-em-producao

# Superadministrador criado pelo seed (altere a senha no primeiro acesso)
SEED_SUPERADMIN_EMAIL=admin@gestalt.local
SEED_SUPERADMIN_PASSWORD=GestaltLive@2026
# Cria o evento de demonstração com 10 perguntas e 3 prêmios
SEED_DEMO=true

# Diretório de uploads de imagens (logos, perguntas, prêmios)
UPLOAD_DIR=./uploads
# Cookies "Secure" (true em produção com HTTPS)
COOKIE_SECURE=false
# Nível de log: debug | info | warn | error
LOG_LEVEL=info
