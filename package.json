{
  "name": "gestalt-live",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestalt Live — plataforma de interação ao vivo, gamificação e satisfação para palestras e treinamentos.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore ./src --ignore ./.next --ignore ./.data server/index.ts",
    "build": "next build && npm run build:server",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --target=node20 --outfile=dist/server.mjs --tsconfig=tsconfig.json",
    "start": "node dist/server.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx server/db/migrate-cli.ts",
    "db:seed": "tsx server/db/seed-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "load": "tsx tests/load/load-test.ts"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@electric-sql/pglite": "^0.5.10",
    "@hono/node-server": "^2.1.5",
    "@hookform/resolvers": "^5.9.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.4",
    "echarts": "^6.1.0",
    "exceljs": "^4.4.0",
    "hono": "^4.13.13",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.58.0",
    "next": "^16.4.2",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.90.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
